# Copy to deployments/docker/.env and change every secret before production use.
#   cp deployments/docker/.env.example deployments/docker/.env

# Public URL of the admin site (used for CORS when frontend is not same-origin)
CORS_ORIGIN=http://localhost

# Host port for the Nginx entrypoint
HTTP_PORT=80

# MySQL
MYSQL_DATABASE=arlo_admin
MYSQL_PASSWORD=change-me-mysql-password

# Redis (leave empty if no auth)
REDIS_PASSWORD=

# JWT — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-jwt-secret
