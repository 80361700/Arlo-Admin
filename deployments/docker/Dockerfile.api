# Stage 1: Build
FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY arlo-admin-server/go.mod arlo-admin-server/go.sum ./
RUN go mod download

COPY arlo-admin-server/ .
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o arlo-admin ./cmd/server/main.go

# Stage 2: Runtime
FROM alpine:3.21

RUN apk --no-cache add ca-certificates tzdata curl gettext \
  && adduser -D -u 1000 appuser
ENV TZ=Asia/Shanghai

WORKDIR /app

COPY --from=builder /app/arlo-admin .
COPY --from=builder /app/configs/ ./configs/
COPY deployments/docker/config.prod.docker.yaml.tmpl ./configs/config.prod.docker.yaml.tmpl
COPY deployments/docker/entrypoint-api.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh \
  && mkdir -p logs uploads \
  && chown -R appuser:appuser /app

USER appuser

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8090/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
